import tkinter as tk
from tkinter import messagebox

def tictactoegame():
    r=tk.Tk()
    r.title("Tic Tac Toe")
    r.geometry("400x450")

    arr=[' ']*9
    player=['X']
    buttons=[]

    def check_winner(p):
        return(
            arr[0]==arr[1]==arr[2]==p or
            arr[3]==arr[4]==arr[5]==p or
            arr[6]==arr[7]==arr[8]==p or
            arr[0]==arr[3]==arr[6]==p or
            arr[1]==arr[4]==arr[7]==p or
            arr[2]==arr[5]==arr[8]==p or
            arr[0]==arr[4]==arr[8]==p or
            arr[2]==arr[4]==arr[6]==p
        )

    def button_click(index):
        if arr[index]!=' ':
            messagebox.showwarning("Warning","Position already taken!")
            return

        arr[index]=player[0]
        buttons[index].config(text=player[0])

        if check_winner(player[0]):
            messagebox.showinfo("Game Over","Player "+player[0]+" wins!")
            reset_game()
            return

        if ' ' not in arr:
            messagebox.showinfo("Game Over","Game Draw!")
            tl.config(text="Game Draw!")
            reset_game()
            return

        if player[0]=='X':
            player[0]='O'
        else:
            player[0]='X'

        tl.config(text="Player "+player[0]+" Turn")

    def reset_game():
        for i in range(9):
            arr[i]=' '
            buttons[i].config(text="")
        player[0]='X'
        tl.config(text="Player X Turn")

    t=tk.Label(r,text="Tic Tac Toe",font=("Arial",24,"bold"))
    t.pack(pady=10)

    tl=tk.Label(r,text="Player X Turn",font=("Arial",16))
    tl.pack()

    f=tk.Frame(r)
    f.pack(pady=20)

    for i in range(9):
        button=tk.Button(
            f,
            text="",
            font=("Arial",24,"bold"),
            width=5,
            height=2,
            command=lambda i=i:button_click(i)
        )

        button.grid(row=i//3,column=i%3,padx=2,pady=2)
        buttons.append(button)

    rb=tk.Button(
        r,
        text="Restart Game",
        font=("Arial",12),
        command=reset_game
    )
    rb.pack()

    r.mainloop()

tictactoegame()
